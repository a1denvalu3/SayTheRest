{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sayIt",
  "version": "0.2.0",
  "identifier": "sh.sayit.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "sayIt",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "player",
        "title": "sayIt player",
        "url": "player.html",
        "width": 360,
        "height": 460,
        "resizable": false,
        "center": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Private local text-to-speech",
    "longDescription": "Read selected text aloud and clone voices with private, local speech models.",
    "icon": ["icons/icon.png"]
  }
}
