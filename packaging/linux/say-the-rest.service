[Unit]
Description=Say the Rest private local speech service
After=graphical-session.target

[Service]
Type=simple
ExecStart=/opt/say-the-rest/say-the-rest-service
WorkingDirectory=/opt/say-the-rest
Environment=LD_LIBRARY_PATH=/opt/say-the-rest/runtime/lib
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
