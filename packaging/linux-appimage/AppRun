#!/bin/sh
set -eu
APP_ROOT=${APPDIR:?AppImage runtime did not provide APPDIR}
export LD_LIBRARY_PATH="$APP_ROOT/usr/bin/runtime/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

if [ "${1:-}" = "--service" ]; then
  shift
  exec "$APP_ROOT/usr/bin/say-the-rest-service" "$@"
fi
if [ "${1:-}" = "--cli" ]; then
  shift
  exec "$APP_ROOT/usr/bin/say-the-rest" "$@"
fi

APP_IMAGE=${APPIMAGE:-}
SETTINGS_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/say-the-rest/desktop-settings.json"
START_AT_LOGIN=1
if [ -f "$SETTINGS_FILE" ] && grep -q '"launch_at_login"[[:space:]]*:[[:space:]]*false' "$SETTINGS_FILE"; then
  START_AT_LOGIN=0
fi
if [ -n "$APP_IMAGE" ] && command -v systemctl >/dev/null 2>&1; then
  UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  mkdir -p "$UNIT_DIR"
  ESCAPED_IMAGE=$(printf '%s' "$APP_IMAGE" | sed 's/[\\&|"]/\\&/g; s/%/%%/g')
  sed "s|@APPIMAGE@|$ESCAPED_IMAGE|g" \
    "$APP_ROOT/usr/share/say-the-rest/say-the-rest-appimage.service" \
    > "$UNIT_DIR/say-the-rest.service"
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  if [ "$START_AT_LOGIN" -eq 1 ]; then
    systemctl --user enable say-the-rest.service >/dev/null 2>&1 || true
  else
    systemctl --user disable say-the-rest.service >/dev/null 2>&1 || true
  fi
  # AppImages mount at a new temporary path each launch. Restart even when the
  # stable AppImage pathname is unchanged so an upgraded image cannot leave the
  # previous mounted service binary running.
  systemctl --user restart say-the-rest.service >/dev/null 2>&1 || true
else
  pgrep -u "$(id -u)" -f 'say-the-rest-service' >/dev/null 2>&1 || \
    "$APP_ROOT/usr/bin/say-the-rest-service" >/dev/null 2>&1 &
fi

if [ -n "$APP_IMAGE" ]; then
  AUTOSTART_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
  mkdir -p "$AUTOSTART_DIR"
  if [ "$START_AT_LOGIN" -eq 1 ]; then
    DESKTOP_IMAGE=$(printf '%s' "$APP_IMAGE" | sed 's/[\\"]/\\&/g')
    cat > "$AUTOSTART_DIR/say-the-rest.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Say the Rest
Comment=Global offline text-to-speech shortcuts
Exec="$DESKTOP_IMAGE"
Terminal=false
X-GNOME-Autostart-enabled=true
EOF
  else
    cat > "$AUTOSTART_DIR/say-the-rest.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Say the Rest
Hidden=true
EOF
  fi
fi
exec "$APP_ROOT/usr/bin/say-the-rest-desktop" "$@"
